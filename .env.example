# MongoDB Configuration
# Para desenvolvimento local, use:
MONGODB_URI=mongodb://localhost:27017/amigo-4-patas

# Para MongoDB Atlas (produção), use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/amigo-4-patas?retryWrites=true&w=majority

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret
CLOUDINARY_UPLOAD_FOLDER=amigo-4-patas
